# ── 复制为 .env 后按需修改；.env 不入库 ─────────────────────────────
# 服务
PORT=8787
LOG_LEVEL=info

# 数据库（MySQL 为主；DB_DRIVER=auto 时连不上 MySQL 自动退回 sqlite 本地开发库）
DB_DRIVER=auto
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=viral_topics
DB_SQLITE_PATH=./.data/dev.db

# Redis / BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=26379
REDIS_PASSWORD=
REDIS_DB=0
QUEUE_PREFIX=viral

# TikHub（对标账号数据源 D4）
TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_PATH_USER_INFO=/api/v1/douyin/app/v3/handler_user_profile
TIKHUB_PATH_USER_POSTS=/api/v1/douyin/app/v3/fetch_user_post_videos
TIKHUB_PATH_VIDEO_DETAIL=/api/v1/douyin/app/v3/fetch_one_video
TIKHUB_PATH_SHARE_PARSE=/api/v1/douyin/app/v3/fetch_one_video_by_share_url
TIKHUB_TIMEOUT_MS=15000
TIKHUB_UNIT_PRICE=0.003

# 财跃 FinStep 资讯接口（ReAct / SSE，作为早参与热榜的补充源）
# 留空则完全不启用，回落到内置示意源 + RSS + 东财
FINSTEP_API_KEY=
FINSTEP_BASE_URL=https://product-backend.finstep.cn
FINSTEP_COMPLETION_PATH=/chat/react/chat/v2/completion
FINSTEP_USER_ID=viral-topics-server
FINSTEP_TIMEOUT_MS=180000
# 逗号分隔：alpha_morning（市场早参）/ hot_topics（热门主题）
# 注意：search_news 与 search_opinion 返回 authorized=false，版权未确认，默认不启用
FINSTEP_SOURCES=alpha_morning,hot_topics
FINSTEP_SUMMARY_MAX_CHARS=300

# 曙光舆情 MCP（saturn-news，JSON-RPC over streamableHttp）
# ⚠️ Authorization 头直接放 key，不要加 "Bearer " 前缀——
#    加了前缀不会 401，而是返回 Output validation error，极容易误判。
# 留空则整源不启用
SATURN_NEWS_MCP_KEY=
SATURN_NEWS_MCP_URL=https://mcpgw.fullgoalservice.com.cn/ext-mcp/saturn-news-mcp
SATURN_NEWS_TIMEOUT_MS=30000
# 周期采集用哪些关键词（逗号分隔），逐个检索后合并去重
SATURN_NEWS_KEYWORDS=A股,基金,央行
# 回看天数（生成 date_range，如 2026-10-16~today）
SATURN_NEWS_LOOKBACK_DAYS=1
SATURN_NEWS_LIMIT=30
# 通道子集：weibo_blog / flash / wechat / web_v1（逗号分隔，留空=四通道全开）
SATURN_NEWS_CHANNELS=flash,wechat,web_v1
SATURN_NEWS_SUMMARY_MAX_CHARS=300
SATURN_NEWS_PROBE_ON_BOOT=false

# 阿里云百炼（LLM + ASR，D5）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_NATIVE_URL=https://dashscope.aliyuncs.com/api/v1
LLM_MODEL=qwen-plus
ASR_MODEL=qwen3-asr-flash-filetrans
LLM_UNIT_PRICE=0.004
ASR_UNIT_PRICE=0.0005

# 文案二创专用模型（Claude / 任意 OpenAI 兼容中转，与百炼并行不冲突）
#   已实测可用的服务：CCG AI（文档 https://ccg-cli.online/docs/）
#     OpenAI 兼容：BASE_URL=https://ccg-cli.online/v1  → POST {base}/chat/completions
#     Anthropic ：BASE_URL=https://ccg-cli.online     → POST {base}/v1/messages（x-api-key）
#   实测模型：claude-opus-5.5（另见模型广场 https://ccg-cli.online/models/）
#   ⚠️ 该中转在 OpenAI 路由上不支持 response_format=json_object，接入层会自动去掉该字段重试，无需手工处理
#   COPY_LLM_BASE_URL / _API_KEY 齐备即启用；留空则自动回退上面的百炼 DASHSCOPE_*
#   PROTOCOL=auto 时按 baseurl+模型名自动判断 anthropic / openai，猜错会自动换协议重试一次
#   成本：INPUT/OUTPUT 分隔单价优先，都为 0 时退化为「总 token × COPY_LLM_UNIT_PRICE」
COPY_LLM_BASE_URL=
COPY_LLM_API_KEY=
COPY_LLM_MODEL=
COPY_LLM_PROTOCOL=auto
COPY_LLM_ANTHROPIC_VERSION=2023-06-01
COPY_LLM_AUTO_FALLBACK_PROTOCOL=true
COPY_LLM_TIMEOUT_MS=180000
COPY_LLM_UNIT_PRICE=0
COPY_LLM_INPUT_PRICE_PER_1K=0
COPY_LLM_OUTPUT_PRICE_PER_1K=0
# ⚠️ 合规闸门（P0-4）：文案与人物档案会发往上面的第三方服务。
#   生产环境必须在获得产品与合规书面批准后显式设为 true，否则即使配置了 COPY_LLM_* 也会回退百炼；
#   开发环境缺省为 true。
COPY_LLM_COMPLIANCE_APPROVED=

# OSS 私有桶（提取链路中转，D11）
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_INTERNAL=false
OSS_PREFIX=benchmark-audio/
OSS_SIGNED_URL_TTL=7200
EXTRACT_MODE=oss

# 提取链路
EXTRACT_MAX_DURATION_MIN=30
TEMP_DIR=./.data/tmp

# 采集与调度（分钟）
NEWS_FETCH_INTERVAL_MIN=15
SWEEP_INTERVAL_MIN=10

# 爆款判定口径（D10）
HOT_MULTIPLIER=3
HOT_BASELINE_SAMPLE=30
HOT_MIN_SAMPLE=5
HOT_REFRESH_DAYS=7

# 抓取队列限流（FR-B3）
FETCH_CONCURRENCY=3
FETCH_RATE_PER_SEC=5

# 文案生成批内并发：真实模型单份 40–60 秒，串行跑多份会超过前端轮询窗口
COPY_GENERATE_ITEM_CONCURRENCY=3

# 展示口径（T3 实测后调整：作品列表对非本人视频若恒返回 0，则置 false 隐藏播放数）
PLAY_COUNT_VISIBLE=false

# 登录与权限（P0-1）：所有接口都要求登录，操作人取自令牌
# 令牌签名密钥：生产必须配置（≥32 字符），否则拒绝启动；开发环境缺省时自动生成到 .data/jwt-secret
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL_HOURS=12
# 库内没有任何账号时用它创建首个管理员；生产必须配置密码，开发环境缺省 admin / admin123
AUTH_BOOTSTRAP_ADMIN_USER=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
# 连续登录失败锁定
AUTH_MAX_LOGIN_FAILURES=5
AUTH_LOCK_MINUTES=5
# 允许跨域的前端来源（逗号分隔）；生产留空 = 只允许同源（前端与 /api 同域部署）
CORS_ORIGINS=

# 后台任务的操作人缺省值（D14；HTTP 请求的操作人一律取自登录账号）
DEFAULT_OPERATOR=ops

# 文案工坊审核桩（审核模块就绪前联调用）：开启时提交后自动模拟三关，并开放
#   POST /review/submissions/:id/decision 裁决（仅审核员 / 管理员）。桩会跳过真实三关，
#   因此缺省按 NODE_ENV 判定：production 关闭，其余开启。关闭后审核单停在「已提交」等待真实审核模块回写
# REVIEW_STUB_ENABLED=true

# 示例数据（P1-6）：示例人物「张经理（示例）」等及其占位授权（无实体材料却标记已核验）。
#   缺省按 NODE_ENV 判定：production 关闭，其余开启。关闭时启动会把已存在的示例人物归档、占位授权撤销（幂等，留审计日志）
# SEED_DEMO=false

# 开启第三方 mock 兜底：无 key 时链路仍可跑通（仅开发/联调用，生产必须置 false）
# ⚠️ 该开关同时影响 TikHub / 百炼 ASR / 百炼 LLM / OSS / 文案模型，
#    不要为了「资讯只看真实数据」而关它——那会让视频提取与文案生成报未配置密钥。
MOCK_FALLBACK=true

# 资讯「内置示意源」（模拟数据）开关，与 MOCK_FALLBACK 解耦。
# false = 热点资讯只展示真实来源（曙光舆情 / 东方财富 / 同花顺 / 财联社 / FinStep 等）
NEWS_MOCK_SOURCE=false
